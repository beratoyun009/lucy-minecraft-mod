diff --git a/webrtc-jni/src/main/cpp/toolchain/aarch64-android-clang.cmake b/webrtc-jni/src/main/cpp/toolchain/aarch64-android-clang.cmake
new file mode 100644
index 0000000000000000000000000000000000000000..9328a041a0762ddaf5d35f0274f57d9f0c3b5d78
--- /dev/null
+++ b/webrtc-jni/src/main/cpp/toolchain/aarch64-android-clang.cmake
@@ -0,0 +1,17 @@
+# Android ARM64 toolchain for FCL/PojavLauncher HotSpot.
+# ANDROID_NDK_HOME is supplied by the GitHub Actions Android setup step.
+if(NOT DEFINED ENV{ANDROID_NDK_HOME})
+    message(FATAL_ERROR "ANDROID_NDK_HOME is required")
+endif()
+
+set(CMAKE_SYSTEM_NAME Android)
+set(CMAKE_ANDROID_NDK "$ENV{ANDROID_NDK_HOME}")
+set(CMAKE_ANDROID_ARCH_ABI arm64-v8a)
+set(CMAKE_ANDROID_API 26)
+set(CMAKE_ANDROID_STL_TYPE c++_static)
+set(ANDROID_ABI arm64-v8a)
+set(ANDROID_PLATFORM android-26)
+set(ANDROID_STL c++_static)
+set(TARGET_CPU arm64)
+
+include("$ENV{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake")
